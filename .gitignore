# Ignore image thumbnail files created by windows
Thumbs.db
# Ignore Finder view option files created by OS X
.DS_Store
# Ignore autogenerated source files
Externals/mGBA/version.c
Source/Core/Common/scmrev.h
# Ignore files output by build
/cmake-build-debug
/cmake-build-release
/[Bb]uild*/
/[Bb]inary*/
/obj/
# Ignore files output by Android cmake build
/Source/Android/app/.cxx/
/libs/
# Ignore various files created by visual studio/msbuild
*.ipch
*.opensdf
*.sdf
*.suo
*.vcxproj.user
*.obj
*.tlog
*.VC.opendb
*.VC.db
.vs*/
/Source/enc_temp_folder/
# Ignore build info file created by QtCreator
CMakeLists.txt.user
# Ignore files created by posix people
*~
# Ignore vim swapfiles
*.swp
# Ignore emacs temp files
\#*\#
.\#*
# Ignore kdevelop files/dirs
*.kdev4
# Ignore IDEA/Clion files/dirs
.idea/
# Ignore Visual Studio Code's working dir
/.vscode/
# Ignore flatpak-builder's cache dir
.flatpak-builder

# clangd cache for Neovim
.cache/clangd

# emsdk (Externals/emsdk submodule): the emsdk repo itself is vendored and
# tracked, but `emsdk install`'s actual downloaded/unpacked toolchain
# binaries (LLVM/binaryen/node, hundreds of MB) are build output, not
# something to commit -- CMake reruns the install/activate step itself
# (see Source/Core/Core/HW/GBAStreamWebClient/CMakeLists.txt) whenever
# they're missing.
/Externals/emsdk/downloads/
/Externals/emsdk/node/
/Externals/emsdk/upstream/
/Externals/emsdk/.emscripten
/Externals/emsdk/.emscripten_sanity*

# WASM web client build output (Source/Core/Core/HW/GBAStreamWebClient/):
# generated by emcc, not source. GBAStreamWebClientJs.h (the same content
# wrapped as a C++ header GBAStreamClientPage.h #includes) is NOT ignored --
# it's committed so a normal build doesn't need emsdk/network access at all,
# only BUILD_GBA_WEB_CLIENT_WASM=ON regenerates+verifies it from source.
Source/Core/Core/HW/GBAStreamWebClient/*.wasm
Source/Core/Core/HW/GBAStreamWebClient/finlink_core.js
Source/Core/Core/HW/GBAStreamWebClient/finlink_core_wasm/
